# Copy to `.env` and adjust. `.env` is git-ignored.

APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres (docker compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Models (Ollama, running on the host) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBED_BATCH_SIZE=32

# --- Ingestion ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# dense | keyword | hybrid | dense+rerank | hybrid+rerank  (see backend/evals/README.md)
RETRIEVAL_MODE=hybrid+rerank
HYBRID_CANDIDATES=30
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=10

# --- Answering ---
# agentic: LangGraph agent (rewrite, grade, retry, self-check) | simple: one retrieve-generate pass
ANSWER_MODE=agentic
RELEVANCE_THRESHOLD=0.05
MAX_RETRIEVAL_ATTEMPTS=2
MAX_GENERATION_ATTEMPTS=2
SELF_CHECK=true

# --- Hybrid knowledge (documents first; web or model knowledge only when documents fail) ---
KNOWLEDGE_MODE=documents
WEB_SEARCH_BACKENDS=auto,yahoo,brave,duckduckgo
WEB_RESULTS=5
# Optional, more reliable web search (free tier): https://tavily.com
# TAVILY_API_KEY=

# --- Evaluation judge (any OpenAI-compatible endpoint; should differ from LLM_MODEL) ---
EVAL_JUDGE_MODEL=qwen2.5:7b
EVAL_JUDGE_BASE_URL=http://localhost:11434/v1
EVAL_JUDGE_API_KEY=ollama
# Groq example: EVAL_JUDGE_BASE_URL=https://api.groq.com/openai/v1 EVAL_JUDGE_MODEL=llama-3.3-70b-versatile
